set -euo pipefail

readonly ARCHMAN_VERSION="1.0.0"

# ── Resolve Library Path ────────────────────────────────────────────
# Support running from source tree or installed location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -d "$SCRIPT_DIR/lib" ]]; then
    LIB_DIR="$SCRIPT_DIR/lib"
elif [[ -d "/usr/local/lib/archman" ]]; then
    LIB_DIR="/usr/local/lib/archman"
elif [[ -d "/usr/lib/archman" ]]; then
    LIB_DIR="/usr/lib/archman"
else
    echo "ERROR: Cannot find archman library directory."
    echo "Expected at: $SCRIPT_DIR/lib or /usr/local/lib/archman"
    exit 1
fi

# ── Source Libraries ────────────────────────────────────────────────
source "$LIB_DIR/ui.sh"
source "$LIB_DIR/settings.sh"
source "$LIB_DIR/install.sh"
source "$LIB_DIR/remove.sh"
source "$LIB_DIR/search.sh"
source "$LIB_DIR/update.sh"
source "$LIB_DIR/cache.sh"
source "$LIB_DIR/lockfile.sh"
source "$LIB_DIR/mirrors.sh"
source "$LIB_DIR/info.sh"
source "$LIB_DIR/packages.sh"
source "$LIB_DIR/export_import.sh"
source "$LIB_DIR/favorites.sh"
source "$LIB_DIR/groups.sh"

# ── Initialization ──────────────────────────────────────────────────
init() {
    detect_capabilities
    settings_init
    log_action "SESSION: archman v$ARCHMAN_VERSION started"
}

# ── Main Menu ───────────────────────────────────────────────────────
main_menu() {
    while true; do
        ui_clear
        ui_banner

        local choice
        choice=$(ui_choose \
            "📦 Install Package" \
            "🗑  Remove Package" \
            "🔍 Search Packages" \
            "📋 Package Utilities" \
            "⬆  System Update" \
            "🔄 Refresh Databases (-Syy)" \
            "🧹 Clean Package Cache" \
            "🔒 Remove pacman db.lck" \
            "🌍 Refresh Mirrors" \
            "📊 System Information" \
            "⭐ Favorite Packages" \
            "📦 Package Groups" \
            "📤 Export / Import" \
            "⚙  Settings" \
            "❌ Exit"
        )

        case "$choice" in
            *"Install Package"*)
                install_menu
                ;;
            *"Remove Package"*)
                remove_menu
                ;;
            *"Search Packages"*)
                search_menu
                ;;
            *"Package Utilities"*)
                packages_menu
                ;;
            *"System Update"*)
                update_menu
                ;;
            *"Refresh Databases"*)
                log_action "UPDATE: Force refreshing package databases from main menu"
                ui_clear
                ui_header "🔄  Refresh Databases"
                ui_info "Force refreshing package databases..."
                if sudo pacman -Syy; then
                    ui_success "Package databases force refreshed!"
                    log_action "UPDATE: Force database refresh successful"
                else
                    ui_error "Force database refresh failed."
                    log_action "UPDATE: Force database refresh failed"
                fi
                ui_pause
                ;;
            *"Clean Package Cache"*)
                cache_menu
                ;;
            *"Remove pacman"*)
                lockfile_menu
                ;;
            *"Refresh Mirrors"*)
                mirrors_menu
                ;;
            *"System Information"*)
                info_menu
                ;;
            *"Favorite"*)
                favorites_menu
                ;;
            *"Package Groups"*)
                groups_menu
                ;;
            *"Export"*)
                export_import_menu
                ;;
            *"Settings"*)
                settings_menu
                ;;
            *"Exit"*|"")
                ui_clear
                echo ""
                if $HAS_GUM; then
                    gum style \
                        --foreground 33 \
                        --bold \
                        --padding "1 2" \
                        "Thanks for using archman! 👋"
                else
                    echo -e "${CLR_CYAN}${CLR_BOLD}Thanks for using archman! 👋${CLR_RESET}"
                fi
                echo ""
                log_action "SESSION: archman exited"
                exit 0
                ;;
        esac
    done
}

# ── CLI Arguments ───────────────────────────────────────────────────
case "${1:-}" in
    --version|-v)
        echo "archman v$ARCHMAN_VERSION"
        exit 0
        ;;
    --help|-h)
        cat <<EOF
archman — Interactive Arch Linux System Manager

Usage:
  archman           Launch the interactive menu
  archman -v        Show version
  archman -h        Show this help

Configuration:
  ~/.config/archman/settings.conf    Settings
  ~/.config/archman/favorites.txt    Favorite packages
  ~/.config/archman/archman.log      Activity log

Dependencies (optional):
  gum               Beautiful TUI components (recommended)
  fzf               Fuzzy finder (fallback)
  reflector         Mirror management
  pacman-contrib    Cache cleaning (paccache)
EOF
        exit 0
        ;;
    "")
        # Normal interactive mode
        ;;
    *)
        echo "Unknown option: $1"
        echo "Run 'archman --help' for usage."
        exit 1
        ;;
esac

# ── Run ─────────────────────────────────────────────────────────────
init
main_menu
